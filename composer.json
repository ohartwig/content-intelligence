{
    "name": "koh/content-intelligence",
    "description": "Content quality and governance analysis for TYPO3 — AI-Readiness scoring, Brand Voice consistency, freshness analysis, and audit trail for AI-generated content.",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "homepage": "https://ole-hartwig.eu/open-source/content-intelligence",
    "authors": [
        {
            "name": "Kai Ole Hartwig",
            "email": "mail@ole-hartwig.eu",
            "homepage": "https://ole-hartwig.eu",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/ohartwig/content-intelligence/issues",
        "source": "https://github.com/ohartwig/content-intelligence",
        "security": "https://github.com/ohartwig/content-intelligence/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.5.11",
        "koh/ai-workflows": "^0.8",
        "typo3/cms-backend": "^14.0",
        "typo3/cms-core": "^14.0",
        "typo3/cms-extbase": "^14.0",
        "typo3/cms-fluid": "^14.0",
        "typo3/cms-scheduler": "^14.0"
    },
    "require-dev": {
        "koh/dev-typo3": "^1.0"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/175/-/packages/composer/packages.json",
            "only": [
                "hn/typo3-mcp-server",
                "netresearch/nr-passkeys-be"
            ]
        },
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/1091/-/packages/composer/packages.json",
            "only": [
                "koh/*"
            ]
        }
    ],
    "autoload": {
        "psr-4": {
            "Koh\\ContentIntelligence\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koh\\ContentIntelligence\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true,
            "sbuerk/typo3-cmscomposerinstallers-testingframework-bridge": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "content_intelligence"
        }
    },
    "scripts": {
        "deptrac": "deptrac analyse",
        "phpstan": "phpstan analyse",
        "test": "phpunit -c Tests/phpunit.xml --testsuite Unit"
    }
}
